@startuml
actor "ESP32" as esp32
participant "API" as api
participant "LSTM" as lstm
database "BD" as db
participant "Telegram" as tg
actor "Usuario" as user

esp32 -> api: POST telemetria (V, I, F)
api -> db: Guarda telemetria
api -> lstm: procesar()
lstm --> api: score anomalia
alt score >= 0.41
  api -> db: Crea incidencia
  api -> tg: Enviar alerta
  tg -> user: Notificacion Telegram
end
api --> esp32: 200 OK
@enduml
