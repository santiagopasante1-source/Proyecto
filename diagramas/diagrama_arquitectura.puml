@startuml
skinparam package {
  BackgroundColor #E8F0FE
  BorderColor #386FA4
}

package "Fisica" {
  [ESP32]
}

package "Backend" {
  [Auth]
  [Telemetry]
  [IAManager]
  [DeviceMonitor]
  [TelegramService]
}

package "Datos" {
  database "PostgreSQL" as db
  file "Modelo\nBi-LSTM" as lstm
}

package "Presentacion" {
  [Dashboard]
}

package "Externo" {
  [Telegram Bot]
}

ESP32 --> Telemetry
Telemetry --> IAManager
IAManager --> lstm
Telemetry --> db
Telemetry --> TelegramService
DeviceMonitor --> db
DeviceMonitor --> TelegramService
Auth --> db
Dashboard --> db
Dashboard --> Telemetry
TelegramService --> Telegram Bot
@enduml
