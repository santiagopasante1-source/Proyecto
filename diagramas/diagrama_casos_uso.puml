@startuml
left to right direction
actor "Usuario" as user
actor "ESP32" as esp32
actor "Telegram" as tg

rectangle "Sistema IoT" as sys {
  usecase "Gestionar cuenta" as UC1
  usecase "Monitorear" as UC2
  usecase "Gestionar\ndispositivos" as UC3
  usecase "Configurar\nnotificaciones" as UC4
  usecase "Enviar telemetria" as UC5
}

user --> UC1
user --> UC2
user --> UC3
user --> UC4
esp32 --> UC5
UC5 ..> UC2 : <<include>>
UC4 ..> tg : <<include>>
@enduml
